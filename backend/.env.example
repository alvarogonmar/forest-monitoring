HOST=127.0.0.1
PORT=3001
# For iPhone LAN testing, set HOST=0.0.0.0 in your local .env.
# Only these browser origins receive CORS permission (native clients do not use CORS).
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Project URL: https://<project-reference>.supabase.co (not a database connection string).
SUPABASE_URL=
# Backend-only Secret key, starting with sb_secret_. Never put it in VITE_/EXPO_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
