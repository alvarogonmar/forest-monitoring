HOST=127.0.0.1
PORT=3001
# For iPhone LAN testing, set HOST=0.0.0.0 in your local .env.
# Only these browser origins receive CORS permission (native clients do not use CORS).
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Project URL: https://<project-reference>.supabase.co (not a database connection string).
SUPABASE_URL=
# Backend-only Secret key, starting with sb_secret_. Never put it in VITE_/EXPO_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
# Separate nonprivileged client for password verification; never reuse the admin DB client to log users in.
SUPABASE_PUBLISHABLE_KEY=
# NODE_ENV=production enables Secure session cookies and requires HTTPS in the browser.
